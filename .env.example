# ====================================================================
# SHYAMEDGE ENVIRONMENT CONFIGURATION
# ====================================================================

# Mode: BACKTEST | PAPER | LIVE (Note: LIVE is hard-coded disabled)
APP_MODE=PAPER
LOG_LEVEL=INFO

# Portfolio Capital Constraints (Calibrated for NIFTY Lot 65 & SENSEX Lot 20)
INITIAL_CAPITAL=30000.00
MAX_RISK_PER_TRADE_PCT=0.03
MAX_DAILY_LOSS_PCT=0.04
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=3

# Database (PostgreSQL with SQLite local auto-fallback)
DATABASE_URL=sqlite:///./shyam_edge.db

# Redis
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Broker Settings (DhanHQ default)
BROKER_PROVIDER=DHAN
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# FYERS Settings (Optional Secondary)
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# Alerts (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_ALERTS=false

# Slippage & Simulation
DEFAULT_SLIPPAGE_PCT=0.004
ROUND_TRIP_BROKERAGE=40.00
